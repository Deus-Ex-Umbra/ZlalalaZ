{
  "name": "proyecto-lalala",
  "version": "1.0.0",
  "private": true,
  "description": "LaLaLa - Sistema de Gestión de Inventario y Punto de Venta (POS) para Tienda de Calzado (Web responsive y PWA)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "iniciar:dev": "concurrently \"npm run iniciar:dev:backend\" \"npm run iniciar:dev:frontend\"",
    "iniciar:dev:backend": "npm run iniciar:dev --prefix backend",
    "iniciar:dev:frontend": "npm run iniciar:dev --prefix frontend",
    "iniciar:prod": "concurrently \"npm run iniciar:prod:backend\" \"npm run iniciar:prod:frontend\"",
    "iniciar:prod:backend": "npm run iniciar:prod --prefix backend",
    "iniciar:prod:frontend": "npm run iniciar:prod --prefix frontend",
    "compilar": "npm run compilar:backend && npm run compilar:frontend",
    "compilar:backend": "npm run compilar --prefix backend",
    "compilar:frontend": "npm run compilar --prefix frontend",
    "formatear": "prettier --write \"frontend/**/*.{ts,tsx,json,css}\" \"backend/**/*.{ts,json}\"",
    "revisar": "npm run revisar:backend && npm run revisar:frontend",
    "revisar:backend": "npm run revisar --prefix backend",
    "revisar:frontend": "npm run revisar --prefix frontend",
    "bd:encender": "powershell -ExecutionPolicy Bypass -File ./encender-bd.ps1",
    "bd:apagar": "powershell -ExecutionPolicy Bypass -File ./apagar-bd.ps1",
    "bd:estado": "powershell -ExecutionPolicy Bypass -File ./estado-bd.ps1",
    "bd:semillar": "npm run semillar --prefix backend",
    "dev": "npm run iniciar:dev",
    "dev:backend": "npm run iniciar:dev:backend",
    "dev:frontend": "npm run iniciar:dev:frontend",
    "build": "npm run compilar",
    "build:backend": "npm run compilar:backend",
    "build:frontend": "npm run compilar:frontend",
    "lint": "npm run revisar",
    "lint:backend": "npm run revisar:backend",
    "lint:frontend": "npm run revisar:frontend",
    "format": "npm run formatear"
  },
  "keywords": [
    "calzado",
    "pos",
    "punto-de-venta",
    "inventario",
    "nextjs",
    "nestjs",
    "cloudflare-r2",
    "driverjs"
  ],
  "author": "Deus Ex Umbra",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
