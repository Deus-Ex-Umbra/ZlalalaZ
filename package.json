{
  "name": "proyecto-zlalalaz",
  "version": "1.0.0",
  "private": true,
  "description": "ZLaLaLaZ - Sistema de Gestión de Inventario y Punto de Venta (POS) para Tienda de Calzado (Web, Escritorio y Móvil con Tauri)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,json,css}\" \"backend/**/*.{ts,json}\""
  },
  "keywords": [
    "calzado",
    "pos",
    "punto-de-venta",
    "inventario",
    "nextjs",
    "nestjs",
    "tauri",
    "rust",
    "cloudflare-r2",
    "driverjs"
  ],
  "author": "Deus Ex Umbra",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
