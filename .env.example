# ==============================================================================
# PROYECTO ZLALALAZ - CONFIGURACIÓN UNIFICADA DE ENTORNO
# Copia este archivo como '.env' en la raíz y en las carpetas correspondientes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=ZLaLaLaZ
PORT_BACKEND=3001
PORT_FRONTEND=3000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (LOCAL Y PRODUCCIÓN)
# ------------------------------------------------------------------------------
# Para pruebas locales con el motor portable copiado en ./pgsql/:
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zlalalaz_calzado_db

# En despliegue (Vercel / Supabase / Neon / Railway):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/zlalalaz_calzado_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y AUTENTICACIÓN (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=zlalalaz_super_secret_jwt_key_2026_calzado_store_bolivia
JWT_EXPIRACION=30d

# ------------------------------------------------------------------------------
# 4. GESTIÓN DE IMÁGENES - ESTRATEGIA "PRESUPUESTO CERO" (CLOUDFLARE R2)
# ------------------------------------------------------------------------------
# Cloudflare R2 ofrece 10 GB de almacenamiento gratuito y 0$ de costos por Egress.
# Protocolo compatible con AWS S3.
#
# Pasos para obtener credenciales en Cloudflare:
# 1. Accede a https://dash.cloudflare.com/ y navega a R2.
# 2. Haz clic en "Manage R2 API Tokens" -> "Create API token".
# 3. Permiso: "Object Read & Write". Aplica al bucket de calzados.
# 4. Copia las credenciales generadas aquí:

STORAGE_PROVIDER=cloudflare_r2
# Opciones: 'cloudflare_r2', 'supabase', 'local'

# Credenciales Cloudflare R2 (S3 Compatible):
R2_ACCESS_KEY_ID=tu_r2_access_key_id_aqui
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key_aqui
R2_ENDPOINT=https://<tu_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=zlalalaz-imagenes-calzado
R2_PUBLIC_DOMAIN=https://pub-<hash>.r2.dev

# ------------------------------------------------------------------------------
# 5. ALTERNATIVA: SUPABASE STORAGE (FALLBACK)
# ------------------------------------------------------------------------------
# Plan gratuito: 1 GB almacenamiento y 5 GB transferencia mensual.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_supabase
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_supabase
SUPABASE_BUCKET_NAME=calzados

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DEL FRONTEND (NEXT.JS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_STORAGE_CDN_URL=https://pub-<hash>.r2.dev
NEXT_PUBLIC_MONEDA_SIMBOLO=Bs
NEXT_PUBLIC_TIENDA_NOMBRE="ZLaLaLaZ - Calzados de Moda"
