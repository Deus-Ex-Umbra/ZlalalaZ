{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZLaLaLaZ",
  "version": "1.0.0",
  "identifier": "com.zlalalaz.pos",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "ZLaLaLaZ — Sistema de Calzado & POS",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
